# Copia este fichero a config.env y ajusta. NO pongas contraseñas aquí si el repo es público:
# los scripts las piden por teclado o las leen de variables de entorno (MIKROTIK_PASS, ES_PASS).

# --- MikroTik (exportador NetFlow) ---
MIKROTIK_IP=10.10.10.1
MIKROTIK_SSH_PORT=22
MIKROTIK_USER=admin

# --- Colector ELK (Elastic Agent con la integración "NetFlow Records") ---
COLLECTOR_IP=10.10.10.14
NETFLOW_PORT=2055
NETFLOW_VERSION=9            # 9 o ipfix (Elastic soporta ambos)
FLOW_INTERFACES=all          # all o lista: ether1,bridge
ACTIVE_FLOW_TIMEOUT=1m
INACTIVE_FLOW_TIMEOUT=15s

# --- Elasticsearch (solo para comprobar que llegan documentos) ---
ES_URL=https://10.10.10.14:9200
ES_USER=elastic
